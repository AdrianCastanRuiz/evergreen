# Local dev: docker-compose Postgres (see repo-root docker-compose.yml).
# Staging/production point these at Neon: DATABASE_URL uses the pooled
# (PgBouncer-compatible) connection string, DIRECT_URL the unpooled one
# used only for running migrations (AD-17).
DATABASE_URL="postgresql://evergreen:evergreen@localhost:5432/evergreen?schema=public"
DIRECT_URL="postgresql://evergreen:evergreen@localhost:5432/evergreen?schema=public"

NODE_ENV="development"
PORT="3000"

# Signs/verifies access + refresh JWTs (AD-8). Generate a real secret per
# environment — never reuse this placeholder outside local dev.
JWT_SECRET="dev-only-change-me"

# Optional in development — Sentry SDK no-ops when unset (AD-15).
SENTRY_DSN=""

# Optional in development — MailService no-ops (logs instead of sending) when
# unset, same convention as SENTRY_DSN above (AD-14).
RESEND_API_KEY=""
MAIL_FROM=""

# Frontend page that reads the `?token=` query param from a password-reset/
# activation email link. Placeholder below since the admin app isn't built
# yet — point this at the real deployed URL per environment.
RESET_PASSWORD_URL="http://localhost:5173/reset-password"

# apps/admin's origin — the single allowed CORS origin (credentialed
# requests can't use "*"). Must match apps/admin's dev server port
# (vite.config.ts) locally, and the real deployed admin URL per environment
# (Story 1.14).
ADMIN_APP_URL="http://localhost:5173"
