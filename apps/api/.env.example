# Local dev: docker-compose Postgres (see repo-root docker-compose.yml).
# Staging/production point these at Neon: DATABASE_URL uses the pooled
# (PgBouncer-compatible) connection string, DIRECT_URL the unpooled one
# used only for running migrations (AD-17).
DATABASE_URL="postgresql://evergreen:evergreen@localhost:5432/evergreen?schema=public"
DIRECT_URL="postgresql://evergreen:evergreen@localhost:5432/evergreen?schema=public"

NODE_ENV="development"
PORT="3000"

# Signs/verifies access + refresh JWTs (AD-8). Generate a real secret per
# environment — never reuse this placeholder outside local dev.
JWT_SECRET="dev-only-change-me"

# Optional in development — Sentry SDK no-ops when unset (AD-15).
SENTRY_DSN=""
