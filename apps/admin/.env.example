# Admin portal environment (Vite inlines VITE_* vars at build time).
# Copy to .env and fill in. Never commit .env.

# Backend base URL. Defaults to http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000

# Sentry DSN (AD-15). Leave empty to disable Sentry in dev builds.
VITE_SENTRY_DSN=
