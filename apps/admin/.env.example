# Admin portal environment (Vite inlines VITE_* vars at build time).
# Copy to .env and fill in. Never commit .env.

# Backend base URL, read by lib/api.ts (Story 1.14). Must match
# apps/api's ADMIN_APP_URL-allowed origin/port for CORS to work.
VITE_API_URL=http://localhost:3000

# Sentry DSN (AD-15). Leave empty to disable Sentry in dev builds.
VITE_SENTRY_DSN=
