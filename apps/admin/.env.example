# Admin portal environment (Vite inlines VITE_* vars at build time).
# Copy to .env and fill in. Never commit .env.

# Backend base URL. No API client reads this yet (scaffold has no business
# screens) — wire up the same optional-chaining default as apps/mobile's
# lib/api.ts once one exists.
VITE_API_URL=http://localhost:3000

# Sentry DSN (AD-15). Leave empty to disable Sentry in dev builds.
VITE_SENTRY_DSN=
