# Mobile app environment (Expo public vars are inlined at build time).
# Copy to .env and fill in. Never commit .env.

# Backend base URL. Defaults to http://localhost:3000 when unset.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry DSN (AD-15). Must be EXPO_PUBLIC_* so it reaches the client bundle.
# Leave empty to disable Sentry in dev builds.
EXPO_PUBLIC_SENTRY_DSN=
