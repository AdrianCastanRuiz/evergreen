    RESIDENT ||--o{ EVENT_REGISTRATION : "el residente queda inscrito"
    USER ||--o{ EVENT_REGISTRATION : "la family la solicita"

    MEAL_MENU_ITEM ||--o{ MEAL_ORDER : "se pide como"
