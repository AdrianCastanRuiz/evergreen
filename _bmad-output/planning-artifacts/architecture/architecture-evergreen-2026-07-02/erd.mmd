erDiagram
    HOME {
        uuid id
        string name
        string timezone
    }
    USER {
        uuid id
        string email
        string role "family, staff, admin, super_admin"
        uuid home_id "vacio solo si super_admin"
    }
    RESIDENT {
        uuid id
        uuid home_id
        string name
        string room
        date dob
    }
    FAMILY_LINK {
        uuid user_id
        uuid resident_id
    }
    CONTENT_ITEM {
        uuid id
        uuid home_id
        string type "news, notice, announcement, static_page, document, schedule"
        string title
        string body
    }
    PHOTO {
        uuid id
        uuid home_id
        uuid resident_id
        string cloudinary_public_id
        string caption
    }
    EVENT {
        uuid id
        uuid home_id
        string title
        datetime date
        int capacity
    }
    EVENT_REGISTRATION {
        uuid id
        uuid event_id
        uuid resident_id
        uuid requested_by_user_id
    }
    MEAL_MENU_ITEM {
        uuid id
        uuid home_id
        date day
        string meal_name
    }
    MEAL_ORDER {
        uuid id
        uuid menu_item_id
        uuid resident_id
        uuid ordered_by_user_id
    }
    DEVICE_TOKEN {
        uuid id
        uuid user_id
        string token
        string platform
    }

    HOME ||--o{ USER : "tiene staff/admins"
